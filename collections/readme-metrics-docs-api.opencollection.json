{
  "opencollection": "1.0.0",
  "info": {
    "name": "ReadMe Api Registry Docs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Docs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a documentation page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dash.readme.com/api/v1/docs/:slug",
            "headers": [
              {
                "name": "x-readme-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a documentation page"
        }
      ]
    }
  ],
  "bundled": true
}